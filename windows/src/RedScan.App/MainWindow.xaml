<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RedScan.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RedScan.App">
    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Eigene Titelleiste in App-Farben (ersetzt den weißen Windows-Balken, folgt Hell/Dunkel) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource PanelBrush}" />
            <Rectangle Grid.Column="1" Fill="{ThemeResource StrokeBrush}" />
            <Border Grid.Column="2" Background="{ThemeResource BgBrush}" />
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/RedScan.ico" Width="16" Height="16" />
                <TextBlock Text="RedScan" FontSize="12" Foreground="{ThemeResource DimBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <local:RootView Grid.Row="1" />
    </Grid>
</Window>
