<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RedScan.App.DetailRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="10" Margin="0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0" FontSize="11" Foreground="{ThemeResource DimBrush}" VerticalAlignment="Top" />
        <TextBlock x:Name="ValueText" Grid.Column="1" Foreground="{ThemeResource TextBrush}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </Grid>
</UserControl>
