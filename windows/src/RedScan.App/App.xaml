<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RedScan.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Farb-Tokens je Darstellung (Default = Dunkel, unverändert; Light = Hell) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BgBrush" Color="#0D0809" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#14090B" />
                    <SolidColorBrush x:Key="CardBrush" Color="#1D1012" />
                    <SolidColorBrush x:Key="CardHiBrush" Color="#2A1316" />
                    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DimBrush" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#52FFFFFF" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#4D000000" />
                    <SolidColorBrush x:Key="RedBrush" Color="#E82230" />
                    <SolidColorBrush x:Key="RedBrightBrush" Color="#FF566B" />
                    <SolidColorBrush x:Key="RedTintBrush" Color="#22E82230" />
                    <SolidColorBrush x:Key="RedPillBrush" Color="#24E82230" />
                    <SolidColorBrush x:Key="RedTintStrokeBrush" Color="#73E82230" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#F6F1F2" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FBF7F7" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHiBrush" Color="#F7E6E8" />
                    <SolidColorBrush x:Key="TextBrush" Color="#1A0F11" />
                    <SolidColorBrush x:Key="DimBrush" Color="#9E1A0F11" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#661A0F11" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#1A1A0F11" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#0D1A0F11" />
                    <SolidColorBrush x:Key="RedBrush" Color="#E82230" />
                    <SolidColorBrush x:Key="RedBrightBrush" Color="#C8102E" />
                    <SolidColorBrush x:Key="RedTintBrush" Color="#1AE82230" />
                    <SolidColorBrush x:Key="RedPillBrush" Color="#1AE82230" />
                    <SolidColorBrush x:Key="RedTintStrokeBrush" Color="#4DE82230" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolVis" xmlns:local="using:RedScan.App" />
            <local:CountToVisibilityConverter x:Key="CountVis" xmlns:local="using:RedScan.App" />
            <local:TextToVisibilityConverter x:Key="TextVis" xmlns:local="using:RedScan.App" />
            <local:NavBackgroundConverter x:Key="NavBg" xmlns:local="using:RedScan.App" />
            <local:TabTitleConverter x:Key="TabTitle" xmlns:local="using:RedScan.App" />
            <local:KindGlyphConverter x:Key="KindGlyph" xmlns:local="using:RedScan.App" />
            <local:KindLabelConverter x:Key="KindLabel" xmlns:local="using:RedScan.App" />

            <!-- Rotes Farbschema: Akzentfarben (Verlauf ist in beiden Modi gleich) -->
            <Color x:Key="RedColor">#E82230</Color>
            <Color x:Key="RedBrightColor">#FF566B</Color>
            <Color x:Key="RedDeepColor">#6B0A12</Color>

            <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource RedBrightColor}" Offset="0" />
                <GradientStop Color="{StaticResource RedColor}" Offset="0.55" />
                <GradientStop Color="{StaticResource RedDeepColor}" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="RedButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RedGradient}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource RedTintBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource RedBrightBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource RedBrightBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
