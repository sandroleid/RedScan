<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RedScan.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolVis" xmlns:local="using:RedScan.App" />
            <local:CountToVisibilityConverter x:Key="CountVis" xmlns:local="using:RedScan.App" />
            <local:TextToVisibilityConverter x:Key="TextVis" xmlns:local="using:RedScan.App" />
            <local:NavBackgroundConverter x:Key="NavBg" xmlns:local="using:RedScan.App" />
            <local:TabTitleConverter x:Key="TabTitle" xmlns:local="using:RedScan.App" />
            <local:KindGlyphConverter x:Key="KindGlyph" xmlns:local="using:RedScan.App" />
            <local:KindLabelConverter x:Key="KindLabel" xmlns:local="using:RedScan.App" />

            <!-- Rotes Farbschema -->
            <Color x:Key="BgColor">#0D0809</Color>
            <Color x:Key="PanelColor">#14090B</Color>
            <Color x:Key="CardColor">#1D1012</Color>
            <Color x:Key="CardHiColor">#2A1316</Color>
            <Color x:Key="RedColor">#E82230</Color>
            <Color x:Key="RedBrightColor">#FF566B</Color>
            <Color x:Key="RedDeepColor">#6B0A12</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHiBrush" Color="{StaticResource CardHiColor}" />
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
            <SolidColorBrush x:Key="RedBrightBrush" Color="{StaticResource RedBrightColor}" />
            <SolidColorBrush x:Key="DimBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="FaintBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#14FFFFFF" />

            <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource RedBrightColor}" Offset="0" />
                <GradientStop Color="{StaticResource RedColor}" Offset="0.55" />
                <GradientStop Color="{StaticResource RedDeepColor}" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="RedButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RedGradient}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="#22E82230" />
                <Setter Property="Foreground" Value="{StaticResource RedBrightBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource RedBrightBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
